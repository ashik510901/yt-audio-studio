# এটা শুধু উদাহরণ। এই ফাইলে আসল পাসওয়ার্ড/কুকি লিখবেন না।
# আসল মান বসান: Streamlit Cloud → আপনার অ্যাপ → Settings → Secrets
# (নিজের কম্পিউটারে চালালে ফাইলটার নাম বদলে .streamlit/secrets.toml করুন;
#  ওই ফাইল .gitignore-এ আছে, GitHub-এ যাবে না।)
# ======================================================================

# (প্রস্তাবিত) অ্যাপে ঢোকার পাসওয়ার্ড। CHANGE_ME দিয়ে শুরু হলে অ্যাপ চালু হবে না।
APP_PASSWORD = "CHANGE_ME_TO_YOUR_OWN_PASSWORD"

# (ঐচ্ছিক) প্রতি ভিডিওর সর্বোচ্চ দৈর্ঘ্য, মিনিটে (ডিফল্ট 180, সর্বোচ্চ 720)
# MAX_MINUTES = 180

# (ঐচ্ছিক) তারিখের টাইমজোন (ডিফল্ট Asia/Dhaka)
# TIMEZONE = "Asia/Dhaka"

# (ঐচ্ছিক) YouTube ব্লক করলে: Netscape ফরম্যাটের cookies.txt-এর পুরো লেখা।
# নিচের তিনটি লাইনের কমেন্ট (#) তুলে আপনার cookies.txt-এর লেখা বসান।
# YT_COOKIES = """# Netscape HTTP Cookie File
# <আপনার cookies.txt-এর বাকি লাইনগুলো>
# """

# (ঐচ্ছিক) নিজের কোনো প্রক্সি থাকলে
# YT_PROXY = "http://USER:PASSWORD@HOST:PORT"
